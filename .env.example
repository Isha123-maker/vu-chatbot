GEMINI_API_KEY=your-gemini-api-key

# Create a Redis database with Upstash and copy these server-side credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set this to the client-IP header supplied and overwritten by your hosting proxy.
# For Vercel, use x-forwarded-for.
CHAT_CLIENT_IP_HEADER=x-forwarded-for
